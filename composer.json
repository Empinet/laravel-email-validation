{
    "name": "empinet/laravel-email-validation",
    "description": "Laravel validation rule for EasyEmailAPI",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "illuminate/contracts": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/http": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/validation": "^10.0|^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "laravel/pint": "^1.0",
        "guzzlehttp/guzzle": "^7.2",
        "orchestra/testbench": "^8.0|^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^10.5|^11.0",
        "larastan/larastan": "^2.0 || ^3.0"
    },
    "autoload": {
        "psr-4": {
            "Empinet\\EasyEmailApi\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Empinet\\EasyEmailApi\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": [
            "@pint",
            "@stan",
            "@phpunit"
        ],
        "pint": "pint --test",
        "stan": "phpstan analyse",
        "phpunit": "phpunit"
    },
    "config": {
        "audit": {
            "block-insecure": false
        },
        "policy": {
            "advisories": {
                "block": false
            }
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Empinet\\EasyEmailApi\\Providers\\EasyEmailApiServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
